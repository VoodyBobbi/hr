# Скопируйте этот файл рядом и назовите .env — тогда он заработает.
# Сам .env в git не попадает (см. .gitignore), в нём хранятся ключи.


# ============================================================
#  ОБЯЗАТЕЛЬНО — без этого не запустится
# ============================================================

# Ключ авторизации GigaChat. Берётся в личном кабинете Сбера.
GIGACHAT_CREDENTIALS=

# Ключ шифрования анкет кандидатов.
# Заполняется автоматически командой:  python start.py
# ВНИМАНИЕ: потеряете ключ — не прочитаете уже собранные анкеты.
ENCRYPTION_KEY=

# С каких адресов сайту разрешено обращаться к боту.
# Через запятую, без пробелов, без слэша на конце.
# Для локальной проверки достаточно значения ниже.
ALLOWED_ORIGINS=http://localhost:8000


# ============================================================
#  ДЛЯ ЛОКАЛЬНОЙ ПРОВЕРКИ на http://localhost
# ============================================================

# Разрешает боту помнить диалог, когда сайт открыт по http без сертификата.
# Оставьте false, пока проверяете на своём компьютере.
# При выкладке на сервер с HTTPS — поменяйте на true.
SESSION_COOKIE_SECURE=false


# ============================================================
#  НЕОБЯЗАТЕЛЬНО — можно не заполнять
# ============================================================

# --- Telegram ---

# Токен бота от @BotFather. Пусто — Telegram-канал просто не запустится,
# сайт при этом работает как обычно.
TELEGRAM_BOT_TOKEN=

# Куда бот пришлёт уведомление о новой заполненной анкете.
# Как узнать id группы — в README, раздел «Уведомления HR о новых заявках».
TELEGRAM_HR_GROUP_CHAT_ID=


# --- Точность поиска ---
# Число от 0 до 1: насколько вопрос кандидата должен совпасть с записью
# в базе. Больше — строже. Значения ниже уже стоят по умолчанию,
# раскомментируйте только если надо подкрутить.

# Порог для готового ответа из faqs.json — он уходит кандидату напрямую,
# без GigaChat. Бот часто «не знает» того, что в базе есть → снизьте до 0.55.
# Отвечает не по делу → поднимите до 0.70.
# FAQ_MIN_SIMILARITY=0.62

# Порог для фактов из data/kb/ — они лишь подсказка для GigaChat,
# поэтому мягче.
# KB_MIN_SIMILARITY=0.35

# Сколько фактов максимум уходит в GigaChat и какой общей длины (в символах).
# Ограничивает расход токенов.
# KB_TOP_K=5
# KB_CONTEXT_CHAR_LIMIT=2500


# --- Прочее ---

# Сколько сообщений в минуту принимать с одного адреса.
# CHAT_RATE_LIMIT_PER_MINUTE=20

# Сколько дней хранить логи обращений. 0 — хранить вечно.
# LOGS_RETENTION_DAYS=90

# Где хранить анкеты, логи и переписку.
# По умолчанию — папки candidates, logs и history в корне проекта.
# Задайте путь, только если данные должны лежать в другом месте.
# HR_DATA_DIR=D:\hr-data

# Нужно, только если чат встроен на сайт с ДРУГИМ доменом, чем сервер бота.
# Тогда поставьте none (Secure включится сам, этого требует браузер).
# SESSION_COOKIE_SAMESITE=lax
