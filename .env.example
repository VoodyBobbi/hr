# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится в git (см. .gitignore).

# Обязательно — доступ к GigaChat API.
GIGACHAT_CREDENTIALS=ваш_ключ_авторизации_GigaChat

# Опционально — модель GigaChat. Идентификаторы модели (см. документацию GigaChat API):
#   GigaChat-2        — Lite, самая дешёвая по токенам (по умолчанию)
#   GigaChat-2-Pro    — Pro
#   GigaChat-2-Max    — Max
#   GigaChat-3-Ultra  — Ultra
GIGACHAT_MODEL=GigaChat-2

# Обязательно — ключ шифрования candidates.csv.
# Сгенерировать: python -m backend.crypto_utils
# Потеря ключа = потеря доступа к анкетам, храните его отдельно (например, в
# менеджере паролей), не только в этом файле.
ENCRYPTION_KEY=

# Опционально — только если нужен канал Telegram.
TELEGRAM_BOT_TOKEN=

# Опционально — где на диске хранить анкеты/историю/логи (персональные
# данные). Если не задано — по умолчанию папка hr-data в домашней директории
# текущего пользователя (~/hr-data). Задайте свой путь, если нужно хранить
# данные в конкретном месте на диске администратора.
# HR_DATA_DIR=/home/admin/hr-data
