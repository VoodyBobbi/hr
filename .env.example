# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не коммитится в git (см. .gitignore).

# Обязательно — доступ к GigaChat API.
GIGACHAT_CREDENTIALS=ваш_ключ_авторизации_GigaChat

# Обязательно — ключ шифрования candidates.csv. Генерируется автоматически
# командой:
#   python setup.py
# (эта же команда ставит зависимости и сама впишет готовый ключ сюда — этой
# строкой обычно не нужно управлять вручную; если нужен ключ отдельно —
# 'python -m backend.crypto_utils' печатает его без установки зависимостей)
ENCRYPTION_KEY=

# Опционально — только если нужен канал Telegram.
TELEGRAM_BOT_TOKEN=

# Опционально — где на диске хранить анкеты/историю/логи (персональные
# данные). Если не задано — три папки в КОРНЕ проекта, рядом с backend/ и
# data/: candidates/ (анкеты), logs/ (лог обращений), history/ (история
# переписки). Все три в .gitignore. Задайте свой путь, если нужно хранить
# данные в другом месте — например вне папки проекта.
# HR_DATA_DIR=/home/admin/hr-data

# Обязательно — с каких сайтов разрешено обращаться к /chat из браузера.
# Через запятую, БЕЗ пробелов, каждый адрес с https:// (или http:// для
# локальной разработки), БЕЗ слэша на конце. Пример для сайта на своём
# домене и локальной проверки одновременно:
# ALLOWED_ORIGINS=https://polati.ru,https://www.polati.ru,http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000

# Опционально — сколько сообщений в /chat разрешено с одного IP-адреса за
# минуту, прежде чем сервер начнёт отвечать "подождите" вместо обращения к
# GigaChat. Если не задано — по умолчанию 20 в минуту.
# CHAT_RATE_LIMIT_PER_MINUTE=20

# Опционально — сколько дней хранить логи обращений (logs.csv), прежде чем
# старые строки удаляются автоматически при каждом запуске сервера. Если не
# задано — по умолчанию 90 дней. 0 означает "хранить логи вечно, не удалять".
# LOGS_RETENTION_DAYS=90

# Опционально — id группы в Telegram, куда бот присылает уведомление о новой
# полностью заполненной анкете кандидата (см. README, раздел "Уведомления
# HR о новых заявках", про то, как узнать правильное значение).
# TELEGRAM_HR_GROUP_CHAT_ID=

# --- Пороги поиска (см. README, раздел "Калибровка порогов поиска") -------
#
# Это КОСИНУСНАЯ БЛИЗОСТЬ: число от 0 до 1, где БОЛЬШЕ значит похожее.
# 0.45 — "примерно об одном", 0.75 — "почти то же самое".
#
# FAQ_MIN_SIMILARITY — порог для готового ответа из faqs.json, который уходит
# кандидату НАПРЯМУЮ, без GigaChat. Строгий: ошибка здесь видна кандидату как
# уверенный ответ не на его вопрос. Если бот слишком часто "не знает" того,
# что есть в FAQ — снизьте до 0.55. Если отвечает не по делу — поднимите
# до 0.70.
# FAQ_MIN_SIMILARITY=0.62
#
# KB_MIN_SIMILARITY — порог для фактов из data/kb/, которые только
# подмешиваются в промпт GigaChat. Мягче: лишний факт дешевле пропущенного.
# KB_MIN_SIMILARITY=0.35
#
# Сколько фактов максимум уходит в промпт и какой суммарной длины (в
# символах). Ограничение держит расход токенов предсказуемым: без него
# вопрос, зацепивший несколько длинных фактов (перечень регионов, список
# противопоказаний), раздул бы промпт в разы против обычного.
# KB_TOP_K=5
# KB_CONTEXT_CHAR_LIMIT=2500

# --- Cookie сессии на сайте ----------------------------------------------
#
# SESSION_COOKIE_SAMESITE: lax (по умолчанию) | strict | none
# lax работает, пока страница с виджетом и сервер бота на одном домене. Если
# виджет встраивается на сайт компании, а бот живёт на отдельном домене или
# поддомене, браузер НЕ приложит cookie с lax к такому запросу — диалог не
# будет помниться, каждое сообщение начнёт новую анкету. Для этого случая
# нужен none (и тогда Secure включается принудительно, этого требует браузер).
# SESSION_COOKIE_SAMESITE=lax
#
# SESSION_COOKIE_SECURE: true (по умолчанию) | false
# false — ТОЛЬКО для локальной проверки по http://localhost без сертификата,
# в том числе для docker compose up. В любом сетевом развёртывании оставляйте
# true: cookie в открытом HTTP-трафике перехватывается в той же сети.
# SESSION_COOKIE_SECURE=true
