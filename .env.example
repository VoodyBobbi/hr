# Переименуйте этот файл в .env и заполните пять строк ниже.
# Больше ничего настраивать не нужно — всё остальное у программы
# уже настроено внутри.


# 1. Ключ доступа к нейросети GigaChat.
#    Берётся в личном кабинете Сбера (developers.sber.ru), раздел GigaChat API.
#    Без него бот не сможет отвечать на вопросы, которых нет в готовых ответах.
GIGACHAT_CREDENTIALS=


# 2. Ключ шифрования анкет кандидатов.
#    Оставьте пустым — программа создаст его сама при первом запуске
#    и впишет сюда. Потом обязательно сохраните его в надёжном месте.
#    ВНИМАНИЕ: потеряете ключ — не прочитаете уже собранные анкеты.
ENCRYPTION_KEY=


# 3. Адрес сайта, на котором работает чат.
#    Нужен, чтобы браузер разрешил странице обращаться к боту.
#
#    Пока проверяете на своём компьютере — оставьте как есть.
#    Когда выложите на сервер — замените на свой домен, например:
#        ALLOWED_ORIGINS=https://polati.ru
#    Несколько адресов пишутся через запятую, без пробелов,
#    без косой черты в конце.
ALLOWED_ORIGINS=http://localhost:8000


# 4. Токен Telegram-бота, с которым общаются кандидаты.
#    Получить: напишите @BotFather команду /newbot и следуйте подсказкам.
#    Можно оставить пустым — тогда работает только сайт, без Telegram.
TELEGRAM_BOT_TOKEN=


# 5. Группа в Telegram, куда приходят уведомления о новых анкетах.
#    Туда же HR нажимает кнопку, чтобы посмотреть все данные кандидата.
#
#    Чтобы подключить свою группу:
#      1) создайте группу и добавьте в неё своего бота;
#      2) сделайте бота администратором, иначе он не сможет писать;
#      3) напишите в группе любое сообщение;
#      4) запустите проверку:  python -m scripts.check_telegram
#         она подскажет номер группы и проверит, всё ли работает.
#
#    Номер всегда начинается с минуса.
TELEGRAM_HR_GROUP_CHAT_ID=
