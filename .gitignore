# Секреты и окружение — САМОЕ ВАЖНОЕ
.env
*.env

# IDE
.idea/
.venv/
venv/

# Python
__pycache__/
*.pyc

# Логи и базы SQLite (не хранить в git)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Персональные данные (анкеты, история переписки, логи) по умолчанию хранятся
