# Секреты и окружение — САМОЕ ВАЖНОЕ
.env
*.env

# IDE
.idea/
.venv/
venv/

# Python
__pycache__/
*.pyc

# Логи и базы SQLite (не хранить в git)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Сгенерированные артефакты векторного индекса (data/). Пересобираются
# автоматически при каждом запуске (python start.py / run_all.py), если
# faqs.json/knowledge_base.json изменились — см. backend/build_index.py.
# Коммитить не нужно: бинарные файлы, должны пересобираться из исходных
# .json на каждой машине заново, а не таскаться через git.
data/faiss_index.bin
data/faqs_metadata.npy
data/data_hash.txt
data/kb_faiss_index.bin
data/kb_metadata.npy
data/kb_data_hash.txt

# Персональные данные (анкеты, история переписки, логи). По умолчанию (без
# HR_DATA_DIR в .env) программа создаёт и пишет их в корне проекта, рядом с
# backend/ и data/ — САМОЕ ВАЖНОЕ, чтобы эти папки никогда не попали в git
# (см. backend/paths.py про то, как программа выбирает путь).
candidates/
history/
logs/

# Правила ниже — подстраховка для старых рабочих копий репозитория (прежние
# имена и расположения) и для локального запуска docker-compose (создаёт
# ./hr-data рядом с кодом, если HR_DATA_DIR не переопределён).
hr-data/
HR/
candidats/
data/conversations/
