# Секреты и окружение — САМОЕ ВАЖНОЕ
.env
*.env

# IDE
.idea/
.venv/
venv/

# Python
__pycache__/
*.pyc

# Логи и базы SQLite (не хранить в git)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Персональные данные (анкеты, история переписки, логи). По умолчанию (без
# HR_DATA_DIR в .env) программа сама создаёт и пишет их в HR/ внутри папки
# проекта, рядом с backend/ и data/ — САМОЕ ВАЖНОЕ, чтобы эта папка никогда
# не попала в git (см. backend/paths.py про то, как программа выбирает путь).
HR/
# Правила ниже — подстраховка для старых рабочих копий репозитория (прошлое
# имя папки без "e" на конце) и для локального запуска docker-compose
# (создаёт ./hr-data рядом с кодом, если HR_DATA_DIR не переопределён).
hr-data/
candidats/
candidates/
data/conversations/
logs/
